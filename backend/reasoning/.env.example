# Copy to .env (setup.sh does). Defaults: the team's shared Neo4j (backend/neo4j, bolt 7688) and the ZRT-served LLM.
NEO4J_URI=bolt://127.0.0.1:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=rescuegrid
NEO4J_DATABASE=neo4j
LLM_PROVIDER=openai_compatible          # openai_compatible | anthropic | none
LLM_BASE_URL=http://127.0.0.1:8080/v1   # ZRT / vLLM proxy on the ZGX Nano
LLM_MODEL=llm
LLM_API_KEY=not-needed
LLM_THINKING=false
