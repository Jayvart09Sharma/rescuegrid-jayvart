# Copy to .env and adjust. Everything defaults to Kenil's LOCAL instances; swap these
# to point at the shared Neo4j / shared LLM later without code changes.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=rescuegrid
NEO4J_DATABASE=neo4j

# Q&A layer LLM. Any OpenAI-compatible endpoint works (vLLM / ZRT / Ollama / OpenAI).
# The ZGX box currently serves Nemotron-3-Nano-30B via ZRT at this URL as model "llm".
LLM_PROVIDER=openai_compatible          # openai_compatible | anthropic | none
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=llm
LLM_API_KEY=not-needed
LLM_THINKING=false                       # Nemotron: reasoning mode off for fast text->Cypher
# ANTHROPIC_API_KEY=...                  # only if LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5
